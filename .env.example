# Nextcloud Log Analyzer - Environment Configuration
# Copy this file to .env and adjust values for production

# === Server Configuration ===
HOST=0.0.0.0
PORT=8000

# === File Upload Limits ===
MAX_FILE_SIZE_MB=2048  # Maximum file size in MB (default: 2GB)

# === Security: CORS ===
# Allowed origins for CORS (comma-separated)
# Development: http://localhost:8000
# Production: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:8000

# === Security: Authentication ===
# Enable API key authentication for external API clients (curl, scripts, etc.)
# NOTE: The web frontend ALWAYS works without authentication!
# Authentication only applies to direct API calls without browser Referer header.
ENABLE_AUTH=false  # Set to 'true' to require API keys for external clients
API_KEY=your-secret-api-key-here-change-me  # Change this in production!

# === Security: Rate Limiting ===
# Protect against DoS attacks
RATE_LIMIT_ENABLED=true
RATE_LIMIT_UPLOAD=5/minute    # Uploads per minute per IP
RATE_LIMIT_API=30/minute      # API calls per minute per IP

# === Storage Paths ===
UPLOAD_DIR=./uploads   # Temporary upload storage
RESULTS_DIR=./results  # Analysis results storage

# === Automatic Cleanup ===
# Automatically delete old results to save disk space
CLEANUP_ENABLED=true
CLEANUP_DAYS=7  # Delete results older than X days

# === Logging ===
# Logs are written to app.log in the backend directory
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

