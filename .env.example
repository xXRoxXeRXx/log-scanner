# Nextcloud Log Analyzer - Environment Configuration

# Server Configuration
PORT=8000
HOST=0.0.0.0

# File Upload Settings
MAX_UPLOAD_SIZE=52428800  # 50MB in bytes

# Python Settings
PYTHONUNBUFFERED=1

# Logging
LOG_LEVEL=info

# Optional: Database (SQLite is default, no config needed)
# DATABASE_PATH=/app/data/analysis.db
